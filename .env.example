# Supabase (real production mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# true: local demo credentials and in-browser CRUD fallback
NEXT_PUBLIC_DEMO_MODE=true
# Productionda faqat maxsus, himoyalangan demo deploy uchun true qiling.
NEXT_PUBLIC_ALLOW_PRODUCTION_DEMO_AUTH=false

# Optional source override for the Excel import script
RIAX_EXCEL_PATH=./RIAX.xlsx
RIAX_SCOPUS_EXCEL_PATH=../RIAX/Scopus ID RIAX.xlsx
RIAX_CONTINGENT_PATH=

# Ixtiyoriy, faqat rasmiy obuna va vakolat mavjud bo‘lsa
ELSEVIER_API_KEY=
WOS_API_KEY=
